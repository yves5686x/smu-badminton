# ============================================================
# 配置清单 / 模板（L4 默认值的镜像）
# ------------------------------------------------------------
# 用法：复制本文件为 .env，然后**只保留需要偏离默认值的行**。
# .env 里与默认值相同的键属于第二份副本，会随代码漂移，请不要保留。
#
# 本文件里每个键都给出代码默认值，由 tests/unit/test_config_layering.py
# 与 config.py 的 code_defaults() 逐键比对锁定——改默认值必须同步改这里，
# 否则测试会失败。
#
# 分层规范（权威说明见 Documents/docs/guide/config.md）：
#   L1 进程环境变量（docker-compose environment: / docker run -e）
#   L2 项目根 .env
#   L3 运行时可变配置（数据库 app_settings 表，界面可改、立即生效）
#   L4 代码默认值（src/smu_badminton/config.py）
# 优先级：L1 > L2 > L4。一个配置项只归属一层。
# ============================================================

# ===== 微服务平台 =====
WF_ORIGIN=https://wf.shmtu.edu.cn
WF_API_URL=https://wf.shmtu.edu.cn/bus/graphql/apps_yy_sys
# 派生值：{WF_ORIGIN}/yy-sys/pc/home，也是默认的登录入口
#WF_HOME_URL=https://wf.shmtu.edu.cn/yy-sys/pc/home
# OAuth2 授权路径（派生授权 URL 用）
#WF_SSO_AUTHORIZE_PATH=/sso/oauth2/authorize
# 派生值：{WF_ORIGIN}/yy-sys/captcha（滑块验证码接口）
#WF_CAPTCHA_URL=https://wf.shmtu.edu.cn/yy-sys/captcha

# ===== CAS 认证 =====
# 只需配置验证码兜底地址：登录页 host 由 cas_login 沿重定向链解析，
# 验证码 URL 与登录 POST 的 Origin 头都按其同源派生，不再单独配置 Origin。
CAS_CAPTCHA_URL=https://sso.shmtu.edu.cn/cas/captcha

# ===== OAuth / 业务资源 =====
OAUTH_CLIENT_ID=kwxKbMKq3Nafw2mApFZz
# 羽毛球场地资源类型 ID
BADMINTON_TYPE_ID=93c2a115-5c73-4e30-bb6a-dfcc5404e46f

# ===== 运行参数 =====
# 服务监听端口（Docker 里由 docker-compose environment: 设为 5000）
#SERVER_PORT=5002
# 预约调试日志（0/1）
#BOOKING_DEBUG=0
# 开发模式热重载（uvicorn reload）
#UVICORN_RELOAD=0

# ===== 缓存与保留期（秒）=====
#TOKEN_CACHE_TTL_SEC=900
#TOKEN_PROFILE_TTL_SEC=3600
# 已完成任务的保留时长；超过后由后台清理任务删除
JOB_RETENTION_SEC=3600

# ===== 数据目录 =====
# 默认 <项目根>/data；Docker 里项目根是 /app，默认即 /app/data
#DATA_DIR=/app/data

# ===== 限流（每窗口请求数 / 窗口秒数）=====
# 其它受保护接口（/api/book、/api/book/schedule、/api/availability）
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=10
# /api/jobs 接口（含前缀）
RATE_LIMIT_JOBS_MAX=300
RATE_LIMIT_JOBS_WINDOW=60

# ===== 安全 =====
# 密码混淆密钥。默认自动生成随机密钥并持久化到 DATA_DIR/secret_key，
# 无需手动配置；显式设置后优先使用（换钥会使已保存凭据失效，重新登录即可重建）
#SECRET_KEY=
# 允许访问任务监控页 / 更新运行时配置的用户名（逗号分隔）。
# 默认为空集合，**必须显式配置**，否则这两个入口对所有用户关闭
#AUTHORIZED_USERS=
# 可信代理 IP 列表（逗号分隔，配置后才信任 X-Forwarded-For）
#TRUSTED_PROXIES=127.0.0.1

# ===== 用户信息默认值（JWT claims 缺字段时的兜底）=====
#DEFAULT_DEPT_CODE=
#DEFAULT_DEPT_NAME=
#DEFAULT_DEPT_NAME_EN=
#DEFAULT_USER_EMAIL=
#DEFAULT_USER_PHONE=
