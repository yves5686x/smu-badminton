# 羽毛球场地资源类型ID
BADMINTON_TYPE_ID=93c2a115-5c73-4e30-bb6a-dfcc5404e46f

# ===== 限流配置（可调整） =====
# 其它受保护接口（/api/book、/api/book/schedule、/api/availability）
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
# /api/jobs 接口（含前缀）
RATE_LIMIT_JOBS_MAX=600
RATE_LIMIT_JOBS_WINDOW=60

# 历史任务保留时长（秒），超出后自动清理
# 604800 = 7天，86400 = 1天，3600 = 1小时
JOB_RETENTION_SEC=604800

# ===== 安全配置（生产/多人使用建议设置） =====
# 密码混淆密钥（默认值不安全，务必替换）
#SECRET_KEY=replace-this-with-your-own-secret
# 允许访问任务监控页/配置更新的用户名列表（逗号分隔）
#AUTHORIZED_USERS=202540510004
# 可信代理 IP 列表（配置后才信任 X-Forwarded-For）
#TRUSTED_PROXIES=127.0.0.1
